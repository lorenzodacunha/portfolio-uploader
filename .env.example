PORT=3333

# Portfolio site (the Astro project) that the uploader reads and writes, relative to this folder or absolute.
SITE_ROOT=../site

# Files inside the site. The content rules are the same ones the site build runs (npm run check:content).
PROJECTS_FILE=src/data/projects.json
PROFILE_FILE=src/data/profile.json
HOME_FILE=src/data/home.json
PERFORMANCE_FILE=src/data/performance.json
RULES_FILE=scripts/description-rules.mjs
ASSETS_DIR=public/assets/projects

# Upload limits
MAX_FILE_SIZE_MB=20
MAX_UPLOAD_FILES=40

# Case images: every new image becomes <id>-<n>.webp at IMAGE_WIDTH and <id>-<n>-640.webp for the cards.
IMAGE_WIDTH=1280
IMAGE_SMALL_WIDTH=640
WEBP_QUALITY=82

# Local AI translation (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
OLLAMA_TIMEOUT_MS=300000

# Link "Ver no site" of each case (the site's dev server: npm run dev in the site folder)
SITE_URL=http://localhost:4321
